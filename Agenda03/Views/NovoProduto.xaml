<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.NovoProduto"
             Title="Novo Produto">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salvar" Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Descrição" />
        <Entry x:Name="txt_descricao" Placeholder="Informe a descrição do produto" />

        <Label Text="Quantidade" />
        <Entry x:Name="txt_quantidade" Placeholder="Informe a quantidade"
               Keyboard="Numeric" />

        <Label Text="Preço" />
        <Entry x:Name="txt_preco" Placeholder="Informe o preço"
               Keyboard="Numeric" />

    </VerticalStackLayout>

</ContentPage>
